{
  "opencollection": "1.0.0",
  "info": {
    "name": "Science Museum Group Collection Documents Search API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search All Collection Types",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://collection.sciencemuseumgroup.org.uk/search",
            "params": [
              {
                "name": "q",
                "value": "steam engine",
                "type": "query",
                "description": "Full-text search query term"
              },
              {
                "name": "random",
                "value": "",
                "type": "query",
                "description": "Return N random records from the collection"
              },
              {
                "name": "page[number]",
                "value": "",
                "type": "query",
                "description": "Zero-indexed page number for pagination"
              },
              {
                "name": "page[size]",
                "value": "",
                "type": "query",
                "description": "Number of results per page (max 100)"
              },
              {
                "name": "date[from]",
                "value": "1800",
                "type": "query",
                "description": "Filter results from this date (year, year-month, or full date)"
              },
              {
                "name": "date[to]",
                "value": "1900",
                "type": "query",
                "description": "Filter results up to this date (year, year-month, or full date)"
              },
              {
                "name": "places",
                "value": "France",
                "type": "query",
                "description": "Filter by geographical association"
              },
              {
                "name": "images",
                "value": "",
                "type": "query",
                "description": "Filter to only items with available images"
              }
            ]
          },
          "docs": "Perform a full-text or filtered search across objects, people, and documents in the Science Museum Group collection. Returns JSONAPI-formatted results with pagination, relevance scoring, and filter aggregations."
        },
